{
  "name": "omg-site",
  "version": "0.1.0",
  "private": true,
  "description": "Alchemy-managed SvelteKit website for OMG",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit": "npm audit",
    "build": "vite build",
    "build:check": "npm run build && npm run check:bundle-budget",
    "check": "npm run check:docs && npm run sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit && npm run typecheck:e2e",
    "check:bundle-budget": "node tools/check-bundle-budget.mjs",
    "check:docs": "node tools/check-docs-freshness.mjs && npm run check:docs:source",
    "check:docs:source": "node tools/check-upstream-review.mjs",
    "seo:indexnow": "node tools/indexnow.mjs",
    "deploy": "npm run build:check && wrangler deploy --config wrangler.production.jsonc --keep-vars",
    "destroy": "node alchemy.environment.mjs destroy",
    "dev": "node alchemy.environment.mjs dev",
    "dev:e2e": "vite dev --host 127.0.0.1 --port 4173",
    "plan": "node alchemy.environment.mjs plan",
    "preview": "vite preview",
    "sync": "svelte-kit sync",
    "test": "npm run test:docs-tools && vitest run --exclude 'e2e/**'",
    "test:docs-tools": "node --test tools/check-upstream-review.node-test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:external": "playwright test",
    "test:e2e:public": "playwright test e2e/anonymous.spec.ts e2e/discovery.spec.ts e2e/documentation.spec.ts",
    "typecheck:e2e": "tsc --project e2e/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "better-auth": "1.7.7",
    "effect": "4.0.2",
    "minisearch": "7.2.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.82",
    "@effect/platform-node": "4.0.2",
    "@playwright/test": "1.63.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@sveltepress/vite": "1.10.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.4",
    "alchemy": "2.0.0-beta.82",
    "deepmerge": "npm:@shivammathur/deepmerge@4.3.2",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "shiki": "3.23.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vfile": "6.0.3",
    "vite": "8.2.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@hono/node-server": "2.1.3",
    "better-auth": {
      "@sveltejs/kit": "3.0.0"
    },
    "hono": "4.13.11",
    "lodash": "4.18.1",
    "valibot": "1.5.0",
    "devalue": "5.9.4",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "deepmerge": "$deepmerge"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": false,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": false,
    "workerd@1.20261002.1": true
  }
}
