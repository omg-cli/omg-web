{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "omg-cve-enrichment",
  "main": "src/enrichment-worker.ts",
  "account_id": "f1e95b3e1b502cf366dfc81a863695fa",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "placement": { "mode": "smart" },
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "ADVISORY_STREAM", "class_name": "AdvisoryStream", "script_name": "omg-cve" },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omg-advisories",
      "database_id": "98202f8c-7d5f-4de9-8ddd-cea35fd95d09",
    },
  ],
  "observability": { "enabled": true },
}
