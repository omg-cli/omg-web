{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "omg-cve",
  "main": "src/index.ts",
  "account_id": "f1e95b3e1b502cf366dfc81a863695fa",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cve.getomg.dev", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "ADVISORY_STREAM", "class_name": "AdvisoryStream" }],
  },
  "migrations": [{ "tag": "advisory-stream-v1", "new_sqlite_classes": ["AdvisoryStream"] }],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": { "enabled": true },
}
