{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "omg-saas-staging",
  "account_id": "f1e95b3e1b502cf366dfc81a863695fa",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "routes": [{ "pattern": "staging-api.getomg.xyz", "custom_domain": true }],
  "vars": { "DEPLOYMENT_STAGE": "staging" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "0f059202-7042-4588-a89f-ce0ae3f6deba",
      "database_name": "omg-platform-staging",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 100, "period": 60 },
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "3002",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "3003",
      "simple": { "limit": 100, "period": 60 },
    },
    {
      "name": "OFFER_RATE_LIMITER",
      "namespace_id": "3004",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
  },
  "placement": { "mode": "smart" },
  "triggers": { "crons": [] },
}
